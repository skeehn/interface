# skeehn docs — environment

# Anthropic API key for the live chat demo (apps/docs/src/app/api/chat/route.ts).
# When unset, the chat route falls back to a canned, still-streaming reply so the
# demo works for contributors and in CI without a key.
ANTHROPIC_API_KEY=

# Optional: override the chat model (defaults to claude-sonnet-4-6).
# CHAT_MODEL=claude-sonnet-4-6
