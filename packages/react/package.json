{
  "name": "@skeehn/react",
  "version": "1.0.0",
  "description": "React 19 components, hooks, and WebGL effects for skeehn",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./gl": {
      "import": "./dist/gl/index.js",
      "types": "./dist/gl/index.d.ts"
    },
    "./styles": "./dist/styles.css",
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist/"],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": { "optional": true },
    "@react-three/postprocessing": { "optional": true },
    "three": { "optional": true }
  },
  "scripts": {
    "build": "bun run ./build.ts"
  },
  "keywords": ["skeehn", "react", "ai", "components", "dither", "ascii", "webgl"],
  "license": "MIT"
}
