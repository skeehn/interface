{
  "name": "skeehn-monorepo",
  "private": true,
  "workspaces": ["packages/*", "apps/*", "examples/*"],
  "bin": {
    "skeehn": "./cli/index.ts"
  },
  "scripts": {
    "dev": "cd apps/docs && bun run dev",
    "docs": "cd apps/docs && bun run dev",
    "test": "bun test",
    "build": "bun run build:core && bun run build:react && bun run build:mcp && bun run build:wc",
    "build:core": "cd packages/core && bun run build",
    "build:react": "cd packages/react && bun run build",
    "build:mcp": "cd packages/mcp-server && bun run build",
    "build:wc": "cd packages/wc && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsdown": "^0.22.3"
  }
}
