{
  "name": "@skeehn/wc",
  "version": "1.1.0",
  "description": "Framework-agnostic Web Components for skeehn — custom elements that work in Vue, Svelte, Astro, Lit, or plain HTML. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist/"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts -d dist"
  },
  "keywords": ["skeehn", "web-components", "custom-elements", "ui", "ai", "vue", "svelte", "astro", "lit"],
  "license": "MIT",
  "devDependencies": {
    "tsdown": "^0.22.3"
  }
}
